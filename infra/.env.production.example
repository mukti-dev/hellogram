# Copy to infra/.env.production (never commit it). All values are required in production.
NODE_ENV=production
LOG_LEVEL=info
# Images to run (CI pushes them to GitHub's registry; deploys set IMAGE_TAG to the commit being deployed).
IMAGE_REGISTRY=ghcr.io/mukti-dev/hellogram
IMAGE_TAG=latest
# Domains (all point at this server; TURN must be DNS-only if you use Cloudflare).
SITE_DOMAIN=hellogram.in
APP_DOMAIN=app.hellogram.in
ADMIN_DOMAIN=admin.hellogram.in
TURN_DOMAIN=turn.hellogram.in
# Admin panel access: list allowed addresses in infra/nginx/admin-allowlist.conf.
ACME_EMAIL=ops@hellogram.in
# Shared number links look like https://hellogram.in/A482719K (nginx forwards them to the app).
PUBLIC_BASE_URL=https://hellogram.in
CORS_ORIGINS=https://app.hellogram.in
ADMIN_CORS_ORIGINS=https://admin.hellogram.in
DATABASE_URL=postgresql://hellogram:<postgres_password>@postgres:5432/hellogram
REDIS_URL=redis://redis:6379
# Phone verification. "firebase" = Firebase Phone Auth (no SMS provider/DLT needed): SMS_PROVIDER=none.
# "otp" = codes via SMS_PROVIDER: twofactor (TWOFACTOR_*), messagecentral (MESSAGECENTRAL_*), msg91 (MSG91_*) or fast2sms (FAST2SMS_*).
PHONE_AUTH_PROVIDER=otp
FIREBASE_PROJECT_ID=
SMS_PROVIDER=twofactor
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_AUTH_TOKEN=
MESSAGECENTRAL_PASSWORD=
MESSAGECENTRAL_EMAIL=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
FAST2SMS_OTP_TEMPLATE_ID=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_NOTICE_TEMPLATE_ID=
# smtp (needs SMTP_URL), or none until you have one (adding an email in the profile is then refused).
EMAIL_PROVIDER=smtp
SMTP_URL=
# Optional bot check (Cloudflare Turnstile). Set together with the VITE_TURNSTILE_SITE_KEY GitHub variable.
TURNSTILE_SECRET=
TRUST_PROXY=1
# Web build-time (Vite) values — baked into the nginx image when it is built:
VITE_PHONE_AUTH=otp
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_TURNSTILE_SITE_KEY=
JWT_ACCESS_SECRET=
HASH_SECRET=
ADMIN_JWT_SECRET=
CONSENT_VERSION=2026-09-v1
OTP_BYPASS=false
RATE_LIMIT_MULTIPLIER=1
MEDIA_PUBLIC_URL=https://app.hellogram.in/media
# Chat attachments: a private S3 bucket + our own encryption key (docs/RUNBOOKS.md §8).
ATTACHMENT_STORAGE=s3
# `openssl rand -base64 32`. Back it up somewhere safe and separate: without it no stored file can ever be read.
ATTACHMENT_ENCRYPTION_KEY=
ATTACHMENT_ENCRYPTION_KEYS_OLD=
S3_BUCKET=
S3_REGION=ap-south-1
# IAM user keys (Lightsail). Leave both empty on EC2 with an instance role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TURN_URLS=turn:turn.hellogram.in:3478?transport=udp,turn:turn.hellogram.in:3478?transport=tcp,turns:turn.hellogram.in:5349?transport=tcp
# The server's public (static) IP, for the call relay. Behind NAT (Lightsail/EC2) use public/private,
# e.g. 15.206.117.38/172.26.11.76 (the private one is `hostname -I` on the server).
TURN_EXTERNAL_IP=
# The server's own (private) address, the part after the "/" above — the only address calls are relayed on.
TURN_RELAY_IP=
TURN_SHARED_SECRET=
# razorpay (needs the RAZORPAY_* keys), or none until then (extra numbers can't be bought; free ones work).
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hellogram.in
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=grievance@hellogram.in
