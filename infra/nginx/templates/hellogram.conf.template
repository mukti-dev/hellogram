# Rendered at start-up by the nginx image (envsubst): ${SITE_DOMAIN} ${APP_DOMAIN} ${ADMIN_DOMAIN}.

# ── HTTP: certificate challenges, everything else → HTTPS ──────────────────────
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

# ── www → apex ─────────────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name www.${SITE_DOMAIN};
  include /etc/nginx/snippets/ssl.conf;
  return 301 https://${SITE_DOMAIN}$request_uri;
}

# ── hellogram.in: landing page ─────────────────────────────────────────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${SITE_DOMAIN};
  include /etc/nginx/snippets/ssl.conf;

  root /srv/site;

  # Shared number links: hellogram.in/A482719K → the public number page in the app.
  location ~* "^/([a-z][0-9]{6,7}[a-z])/?$" {
    return 301 https://${APP_DOMAIN}/$1;
  }
  # Typed shortcuts.
  location ~ ^/(login|signup)/?$ {
    return 302 https://${APP_DOMAIN}/$1;
  }
  location = /app {
    return 302 https://${APP_DOMAIN}/;
  }

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/site-csp.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/site-csp.conf;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}

# ── app.hellogram.in: web app + API ────────────────────────────────────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${APP_DOMAIN};
  include /etc/nginx/snippets/ssl.conf;

  root /srv/web;

  # API. Files are uploaded raw (10 MB max), so allow a little more here.
  location /v1/ {
    proxy_read_timeout 75s;
    client_max_body_size 12m;
    proxy_request_buffering off;
    include /etc/nginx/snippets/proxy.conf;
    # The API sets its own security headers (and a stricter CSP for chat files).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    proxy_pass http://api:4000;
  }
  location /socket.io/ {
    include /etc/nginx/snippets/proxy.conf;
    # Long-lived realtime connection.
    proxy_read_timeout 1h;
    proxy_pass http://api:4000;
  }
  location /health/ {
    proxy_read_timeout 75s;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://api:4000;
  }
  location /media/ {
    proxy_read_timeout 75s;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass http://api:4000;
  }

  # Web app (single-page): built assets are cached forever, the shell never.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location = /sw.js {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri =404;
  }
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;
    # Our origin, Razorpay checkout, Cloudflare Turnstile, Firebase Phone Auth (+ reCAPTCHA).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://checkout.razorpay.com https://challenges.cloudflare.com https://www.google.com https://www.gstatic.com https://apis.google.com; frame-src https://api.razorpay.com https://checkout.razorpay.com https://challenges.cloudflare.com https://www.google.com https://*.firebaseapp.com; connect-src 'self' wss://${APP_DOMAIN} https://lumberjack.razorpay.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://www.google.com; img-src 'self' data: blob: https://www.gstatic.com https://static.klipy.com https://static1.klipy.com https://static2.klipy.com; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}

# ── admin.hellogram.in: admin panel (allowlisted addresses only) ───────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};
  include /etc/nginx/snippets/ssl.conf;

  include /etc/nginx/admin-allowlist.conf;
  root /srv/admin;

  location /admin/v1/ {
    proxy_read_timeout 75s;
    include /etc/nginx/snippets/proxy.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    proxy_pass http://admin-api:4100;
  }
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'" always;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
