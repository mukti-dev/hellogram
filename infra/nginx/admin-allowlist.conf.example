# Copy to infra/nginx/admin-allowlist.conf and list the addresses allowed to open the admin panel
# (office, VPN). Everyone else gets 403. Restart nginx after editing (a reload keeps reading the old file):
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.production restart nginx
allow 203.0.113.10;
# allow 198.51.100.0/24;
deny all;
