{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hellogram/api",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hellogram/worker",
        "dev"
      ]
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hellogram/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "turn",
      "runtimeExecutable": "turnserver",
      "runtimeArgs": [
        "-c",
        "infra/coturn/turnserver.local.conf"
      ],
      "port": 3478
    },
    {
      "name": "admin-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hellogram/admin-api",
        "dev"
      ],
      "port": 4100
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hellogram/admin",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "api-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=4010",
        "SMS_PROVIDER=console",
        "OTP_BYPASS=true",
        "PHONE_AUTH_PROVIDER=otp",
        "CORS_ORIGINS=http://localhost:5180",
        "RATE_LIMIT_MULTIPLIER=50",
        "pnpm",
        "--filter",
        "@hellogram/api",
        "dev"
      ],
      "port": 4010
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "HELLOGRAM_API_PROXY=http://localhost:4010",
        "pnpm",
        "--filter",
        "@hellogram/web",
        "exec",
        "vite",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hellogram/site",
        "dev"
      ],
      "port": 5176
    }
  ]
}