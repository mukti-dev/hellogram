        "infra/coturn/turnserver.local.conf"
      ],
      "port": 3478
    },
    {
      "name": "admin-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@hellogram/admin-api",
        "dev"
      ],
