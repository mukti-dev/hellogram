{
  "name": "@hellogram/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../tools/build-node.mjs src/main.ts"
  },
  "dependencies": {
    "@hellogram/application": "workspace:*",
    "@hellogram/config": "workspace:*",
    "@hellogram/db": "workspace:*",
    "@hellogram/domain": "workspace:*",
    "@hellogram/infrastructure": "workspace:*",
    "@hellogram/shared": "workspace:*",
    "argon2": "^0.45.1 @prisma/client@7.10.0 @prisma/adapter-pg@7.10.0 pg@^8.23.0 bullmq@^6.3.9 ioredis@^5.11.1 pino@^10.3.1",
    "bullmq": "^6.3.9",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
