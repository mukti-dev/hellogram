NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://hellogram:hellogram@localhost:5433/hellogram
REDIS_URL=redis://localhost:6379
BILLING_PROVIDER=dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hellogram.app
PUBLIC_BASE_URL=http://localhost:5173

# Chat attachments (photos and files). Files are encrypted by the API before they are stored.
# local = encrypted files in ATTACHMENT_DIR (development); s3 = private S3 bucket (required in production).
ATTACHMENT_STORAGE=local
# 32 random bytes, base64: `openssl rand -base64 32`. Must be the same in apps/api and apps/worker.
# Leave unset in development to use the built-in dev key. NEVER lose the production key: files can't be read without it.
# ATTACHMENT_ENCRYPTION_KEY=
# After rotating the key, list the previous key(s) here (comma-separated) so older files stay readable.
# ATTACHMENT_ENCRYPTION_KEYS_OLD=
# S3_BUCKET=hellogram-attachments-prod
# S3_REGION=ap-south-1
# Leave both empty on a server with an IAM role.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
