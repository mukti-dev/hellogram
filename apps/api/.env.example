NODE_ENV=development
LOG_LEVEL=debug
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://hellogram:hellogram@localhost:5433/hellogram
REDIS_URL=redis://localhost:6379
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0123456789
HASH_SECRET=dev-only-hash-secret-change-me-please-0123456789ab
CONSENT_VERSION=2026-09-v1
SESSION_TTL_DAYS=90
# TESTING ONLY: accept any 6-digit OTP. The API refuses to start with this in production.
OTP_BYPASS=true
CODE_DIGITS=6
MEDIA_DIR=.data/media
MEDIA_PUBLIC_URL=/media
# Loosens per-IP limits for local testing (must be 1 in production)
RATE_LIMIT_MULTIPLIER=20
# Voice relay (coturn). Clients get short-lived credentials; calls are relay-only.
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SHARED_SECRET=dev-turn-secret-change-me
# Payments: "dev" = built-in simulator (no keys), "razorpay" = real (required in production)
BILLING_PROVIDER=dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hellogram.app
# Phone verification: "otp" (our SMS / dev bypass) or "firebase" (Firebase Phone Auth).
PHONE_AUTH_PROVIDER=otp
FIREBASE_PROJECT_ID=
# console (dev: logs codes) | msg91 | none (Firebase mode — Google sends the SMS)
SMS_PROVIDER=console

# Chat attachments (photos and files). Files are encrypted by the API before they are stored.
# local = encrypted files in ATTACHMENT_DIR (development); s3 = private S3 bucket (required in production).
ATTACHMENT_STORAGE=local
# 32 random bytes, base64: `openssl rand -base64 32`. Must be the same in apps/api and apps/worker.
# Leave unset in development to use the built-in dev key. NEVER lose the production key: files can't be read without it.
# ATTACHMENT_ENCRYPTION_KEY=
# After rotating the key, list the previous key(s) here (comma-separated) so older files stay readable.
# ATTACHMENT_ENCRYPTION_KEYS_OLD=
# S3_BUCKET=hellogram-attachments-prod
# S3_REGION=ap-south-1
# Leave both empty on a server with an IAM role.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Fast2SMS (India) — our server makes and checks the code, Fast2SMS only delivers it.
# SMS_PROVIDER=fast2sms and PHONE_AUTH_PROVIDER=otp to use it; OTP_BYPASS=false for real codes.
# FAST2SMS_API_KEY=            (Fast2SMS dashboard → Dev API. Never commit it.)
# FAST2SMS_ROUTE=otp           (otp = Fast2SMS's own OTP route, no DLT; dlt = your DLT template below)
# FAST2SMS_OTP_TEMPLATE_ID=

# Message Central VerifyNow (India) — they make, send and check the code; no DLT of ours needed.
# SMS_PROVIDER=messagecentral and PHONE_AUTH_PROVIDER=otp to use it; OTP_BYPASS=false for real codes.
# MESSAGECENTRAL_CUSTOMER_ID=     (Message Central dashboard, e.g. C-XXXXXXXXXXXXXXX)
# MESSAGECENTRAL_AUTH_TOKEN=     (the token from the Message Central dashboard. Never commit it.)
# MESSAGECENTRAL_PASSWORD=        (optional instead/as well: lets the app renew the token itself)
# MESSAGECENTRAL_EMAIL=           (optional: the account email)

# 2Factor.in — they make the code, deliver it (voice call, or SMS with an approved template) and check it.
# SMS_PROVIDER=twofactor and PHONE_AUTH_PROVIDER=otp to use it; OTP_BYPASS=false for real codes.
# The app then tells people they may get a call instead of an SMS.
# TWOFACTOR_API_KEY=          (2Factor dashboard. Never commit it.)
# TWOFACTOR_OTP_TEMPLATE=     (optional: name of an approved OTP SMS template in 2Factor)
