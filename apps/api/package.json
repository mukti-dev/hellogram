{
  "name": "@hellogram/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "build": "node ../../tools/build-node.mjs src/server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@hellogram/application": "workspace:*",
    "@hellogram/config": "workspace:*",
    "@hellogram/db": "workspace:*",
    "@hellogram/domain": "workspace:*",
    "@hellogram/infrastructure": "workspace:*",
    "@hellogram/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1 @prisma/client@7.10.0 @prisma/adapter-pg@7.10.0 pg@^8.23.0 bullmq@^6.3.9 ioredis@^5.11.1 pino@^10.3.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  }
}
