# Phone verification: "otp" (our server sends SMS / dev bypass) or "firebase" (Firebase Phone Auth).
# Must match PHONE_AUTH_PROVIDER in apps/api/.env.
VITE_PHONE_AUTH=otp
# Firebase web app config (Project settings → Your apps). These are public values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Cloudflare Turnstile site key (bot check before our own OTP sends). Leave empty in development.
VITE_TURNSTILE_SITE_KEY=
