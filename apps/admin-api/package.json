{
  "name": "@hellogram/admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "create-admin": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:int": "vitest run",
    "build": "node ../../tools/build-node.mjs src/server.ts src/cli/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@hellogram/application": "workspace:*",
    "@hellogram/config": "workspace:*",
    "@hellogram/db": "workspace:*",
    "@hellogram/domain": "workspace:*",
    "@hellogram/infrastructure": "workspace:*",
    "@hellogram/shared": "workspace:*",
    "argon2": "^0.45.1 @prisma/client@7.10.0 @prisma/adapter-pg@7.10.0 pg@^8.23.0 bullmq@^6.3.9 ioredis@^5.11.1 pino@^10.3.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
